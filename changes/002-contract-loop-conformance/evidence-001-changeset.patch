@@ -0,0 +1,35 @@
+"""T028 — offline login-shell classification oracle (Esc#2, FR-003/FR-018).
+
+The first live run bounced to a client-rendered ForgeRock SSO login shell and the adapter,
+reading the DOM pre-render, saw `<title>Login</title>` + `data-testid="fr-body-image"` and
+an empty `appRoot` — NOT the post-render `"University of Phoenix Login"` marker `is_login_page`
+used to key on. FR-018's self-snapshot captured that exact shell, so the login-classification
+fix is an OFFLINE oracle (the captured shell IS the fixture), not a live residue.
+"""
+
+from discuss.portal_parse import classify_landing, is_login_page
+
+# Deliberately NOT a `/login` URL: detection must come from the pre-render BODY markers, since
+# the live `page.url` after the SSO bounce was the engagement URL, not a tell-tale login path.
+# Keying off the URL alone is exactly what failed to save the first live run.
+_ENGAGEMENT_URL = "https://vle.phoenix.edu/ultra/courses/_577963_1/engagement"
+
+
+def test_classify_prerender_login_shell(login_shell_prerender_html):
+    # Esc#2/FR-003: the un-rendered ForgeRock shell classifies as a login page from its
+    # pre-render markup — the bug the first live run hit (it read as a selector miss instead).
+    assert classify_landing(_ENGAGEMENT_URL, login_shell_prerender_html) == "login"
+    assert is_login_page(_ENGAGEMENT_URL, login_shell_prerender_html) is True
+
+
+def test_classify_discussions_list(discussions_fixture_html, discussions_url):
+    # FR-004: the rendered discussions list classifies as `discussions` (rows resolve), so the
+    # pipeline proceeds rather than mistaking a real list for a login/unknown landing.
+    assert classify_landing(discussions_url, discussions_fixture_html) == "discussions"
+
+
+def test_classify_unknown_markup():
+    # FR-018: arbitrary markup that is neither login nor a discussions list is `unknown`, so a
+    # genuine selector miss stays distinguishable from a login redirect (the diagnostic stays
+    # honest — a miss is a miss, a login bounce is a login bounce).
+    assert classify_landing("https://example.com/x", "<html><body><p>hi</p></body></html>") == "unknown"
diff --git a/tests/test_main_smoke.py b/tests/test_main_smoke.py
new file mode 100644
index 0000000..ed618d7
--- /dev/null
+++ b/tests/test_main_smoke.py
@@ -0,0 +1,121 @@
+"""T024 — no-mock entry-point smoke gate (SC-006, FR-001).
+
+The layer Escalation #1 lacked: drive the REAL entry-point wiring — ``Config.load(
+_load_overrides()) → run(...)`` — to a *defined* state, stubbing ONLY ``browser_factory``
+at the outermost (live-browser) boundary. No fake of any internal seam. The fatal
+``IndexError`` that passed every other gate lived precisely in the ``Config.load → run``
+seam the orchestrator fakes replaced; this test exercises that seam for real, so "the
+program starts and reaches a defined state" is now gated — not just unit fakes.
+"""
+
+import datetime as dt
+
+import pytest
+
+from discuss import cli
+from discuss.config import Config
+from discuss.errors import NoUpcomingDiscussion, NotAuthenticated
+
+
+class _FakePage:  # an outermost-boundary stub: a logged-in portal with no discussions
+    def content(self):
+        return "<html></html>"
+
+
+def _stub_browser_factory():
+    return (object(), _FakePage())
+
+
+def test_main_smoke_reaches_defined_state(monkeypatch, tmp_path):
+    # SC-006: with a valid config + only the browser stubbed, the REAL Config.load→run
+    # reaches a DEFINED state (NoUpcomingDiscussion), proving the seam is wired — not an
+    # IndexError. This is the path that died on the first live invocation before the fix.
+    monkeypatch.setenv("DISCUSS_TARGET_CLASSES", "_577963_1")
+    monkeypatch.setenv("DISCUSS_RUN_ROOT", str(tmp_path))
+    from discuss.config import Config
+
+    cfg = Config.load(cli._load_overrides())                    # REAL config gathering
+
+    class _A:                                                   # adapter at the live boundary
+        def go_to_discussions(self, page, cid):
+            pass
+
+        def list_discussions(self, page):
+            return []                                           # → select_soonest_due None
+
+    with pytest.raises(NoUpcomingDiscussion):
+        cli.run(config=cfg, browser_factory=_stub_browser_factory, adapter=_A(),
+                today=dt.date(2026, 6, 1), ensure_logged_in=lambda p: None)
+
+
+def test_main_no_class_exits_with_guidance(monkeypatch, capsys):
+    # the guard that the original IndexError needed: real main(), no class → rc 2 + guidance.
+    monkeypatch.delenv("DISCUSS_TARGET_CLASSES", raising=False)
+    assert cli.main() == 2
+    assert "DISCUSS_TARGET_CLASSES" in capsys.readouterr().out
+
+
+# --- T029: auth re-sequenced AFTER navigation, with one in-context retry (Esc#2) ----------
+#
+# No-mock smoke EXTENSION (SC-006 discipline): only the outermost live boundary (the stub
+# adapter standing in for the live portal) is faked — the REAL `cli.run` orchestration drives
+# the new navigate → (login? pause + retry once) → proceed seam. The pre-navigation auth check
+# (which a fresh about:blank page could never use to see a post-navigation SSO redirect) is
+# gone; this gates the seam that replaces it.
+
+
+def test_auth_pause_is_post_navigation_with_retry(tmp_path):
+    # the manual-login pause fires AFTER the first navigation, the navigation is retried
+    # EXACTLY once in-context, then the run proceeds to a defined state — and NO auth check
+    # runs before the first navigation (the first recorded event is a navigate, not a pause).
+    events = []
+
+    class _A:
+        def __init__(self):
+            self.nav = 0
+
+        def go_to_discussions(self, page, cid):
+            self.nav += 1
+            events.append("navigate")
+            if self.nav == 1:
+                raise NotAuthenticated("portal redirected to login")
+            # second navigation (post-login) succeeds
+
+        def list_discussions(self, page):
+            return []  # → NoUpcomingDiscussion: a DEFINED downstream state
+
+    def pause(page):
+        events.append("pause")
+
+    cfg = Config.load(
+        {"target_classes": ["_x"], "run_root": tmp_path, "confirm": False, "editor_cmd": ["true"]}
+    )
+    a = _A()
+    with pytest.raises(NoUpcomingDiscussion):
+        cli.run(config=cfg, browser_factory=lambda: (object(), object()), adapter=a,
+                today=dt.date(2026, 6, 1), ensure_logged_in=pause)
+    assert events == ["navigate", "pause", "navigate"]  # pause AFTER nav; exactly one retry
+    assert a.nav == 2
+
+
+def test_login_landing_routes_to_pause_not_selector_miss(tmp_path):
+    # a login landing routes to the manual-login PAUSE path (not surfaced as a SelectorMiss);
+    # if the operator never authenticates, NotAuthenticated propagates after the single retry.
+    events = []
+
+    class _A:
+        def go_to_discussions(self, page, cid):
+            events.append("navigate")
+            raise NotAuthenticated("still on login")  # login persists across the retry
+
+    def pause(page):
+        events.append("pause")
+
+    cfg = Config.load(
+        {"target_classes": ["_x"], "run_root": tmp_path, "confirm": False, "editor_cmd": ["true"]}
+    )
+    with pytest.raises(NotAuthenticated):
+        cli.run(config=cfg, browser_factory=lambda: (object(), object()), adapter=_A(),
+                today=dt.date(2026, 6, 1), ensure_logged_in=pause)
+    # paused (not errored as a SelectorMiss) and retried exactly once before giving up
+    assert events == ["navigate", "pause", "navigate"]
diff --git a/tests/test_no_creds.py b/tests/test_no_creds.py
new file mode 100644
index 0000000..c6f43fd
--- /dev/null
+++ b/tests/test_no_creds.py
@@ -0,0 +1,41 @@
+"""T023 — structural no-credentials oracle (FR-002, SC-007).
+
+An offline, every-build proof that no module writes a credential or automates a login
+form: the only persistent-state path is the operator's own browser profile dir handed to
+``launch_persistent_context``. Scans the ``src/discuss`` tree as CODE — docstrings stripped
+and comments dropped (``ast.unparse``) — so the safety prose that legitimately mentions
+"password"/"credential" cannot false-RED this oracle (G1 caught the earlier bare-word form
+red-ing on a "no password field" comment). Falsifiable: a ``page.fill("#password", …)`` or
+a secrets-file write reds it.
+"""
+
+import ast
+import pathlib
+
+SRC = pathlib.Path("src/discuss")
+
+
+def _code_only(py: pathlib.Path) -> str:
+    """Module source as code: docstrings stripped, comments dropped (``ast.unparse``) — so
+    the safety prose that mentions 'password'/'credential' cannot false-RED this oracle (G1
+    caught the earlier bare-word form red-ing on the 'no password field' comment)."""
+    tree = ast.parse(py.read_text())
+    for node in ast.walk(tree):
+        body = getattr(node, "body", None)
+        if (isinstance(body, list) and body and isinstance(body[0], ast.Expr)
+                and isinstance(getattr(body[0], "value", None), ast.Constant)
+                and isinstance(body[0].value.value, str)):
+            node.body = body[1:]                   # drop this scope's docstring
+    return ast.unparse(tree).lower()
+
+
+def test_no_credentials_persisted():
+    # FR-002/SC-007: never automate the login form, never store a credential. Scan CODE only,
+    # and only for ACTIONABLE patterns (an API call / a real selector / a secrets file) — not
+    # the bare words that appear in the modules' safety comments.
+    code = "\n".join(_code_only(p) for p in SRC.glob("*.py"))
+    for forbidden in ("getpass", "keyring", "#password", "secret=", "credentials.json",
+                      "password_field", "login_form", ".fill(pw"):
+        assert forbidden not in code, f"a module's CODE references {forbidden!r}"
+    # the only persistence is the operator's own browser profile (no stored secret)
+    assert "launch_persistent_context" in (SRC / "browser.py").read_text()
diff --git a/tests/test_no_submit.py b/tests/test_no_submit.py
new file mode 100644
index 0000000..0599b34
--- /dev/null
+++ b/tests/test_no_submit.py
@@ -0,0 +1,38 @@
+"""T021 — structural no-submit oracle (FR-010, SC-007).
+
+An offline, every-build proof of a safety *absence*: the reply-fill code path contains no
+submit/post-control lookup or click. It reads the *source* of ``portal_adapter.fill_reply``
+and scans the CODE only — the docstring (which legitimately documents the no-submit
+guarantee) and comments are stripped first, so the oracle cannot false-RED on the prose
+that describes the guarantee (the earlier bare ``"submit" in getsource`` form did exactly
+that; G1 caught it). Falsifiable: inject a post-button ``.click()`` and it reds; revert and
+it greens.
+"""
+
+import ast
+import inspect
+
+from discuss import portal_adapter
+
+
+def _code_without_docstring(fn) -> str:
+    """The function as code with its docstring removed and comments dropped, so the oracle
+    scans CODE — not the prose that legitimately documents the no-submit guarantee. (The
+    earlier ``"submit" in getsource`` form false-RED'd on the docstring; G1 caught it.)"""
+    node = ast.parse(inspect.getsource(fn)).body[0]
+    body = node.body
+    if (body and isinstance(body[0], ast.Expr)
+            and isinstance(getattr(body[0], "value", None), ast.Constant)
+            and isinstance(body[0].value.value, str)):
+        node.body = body[1:]                       # drop the docstring statement
+    return ast.unparse(node).lower()               # ast.unparse omits comments entirely
+
+
+def test_fill_reply_has_no_submit_path():
+    # FR-010/SC-007: the fill CODE may not look up or click a submit/post control. A green
+    # here certifies the *absence* of every submit path on every build — the guarantee that
+    # is the whole reason this tool is permitted to touch the reply field at all.
+    code = _code_without_docstring(portal_adapter.fill_reply)
+    for forbidden in ("submit", "post-button", "btn_post", "publish", "[type='submit']"):
+        assert forbidden not in code, f"fill_reply CODE references {forbidden!r}"
+    assert code.count(".click(") <= 1              # the only click focuses the editable field
diff --git a/tests/test_portal_parse.py b/tests/test_portal_parse.py
new file mode 100644
index 0000000..9ee7d39
--- /dev/null
+++ b/tests/test_portal_parse.py
@@ -0,0 +1,167 @@
+import datetime as dt
+
+from discuss.portal_parse import (
+    extract_prompt_text,
+    is_login_page,
+    parse_discussions,
+    select_soonest_due,
+    verify_fill_readback,
+)
+
+
+def test_readback_match_ignores_trailing_ws():
+    # FR-012: a trailing newline from the field read-back must not count as a mismatch.
+    assert verify_fill_readback("My answer.", "My answer.\n") is True
+
+
+def test_readback_mismatch_detected():
+    # FR-012: a partial/garbled paste must fail verification.
+    assert verify_fill_readback("My full answer.", "My full") is False
+
+
+def test_readback_empty_intended_is_false():
+    # edge: an empty/whitespace-only intended text is never a valid successful fill.
+    assert verify_fill_readback("", "anything") is False
+
+
+def test_readback_richtext_wrappers_compare_on_text():
+    # edge: a rich-text field returns the text wrapped in <p>…</p>; verification must
+    # compare on text content so the markup wrapper is not seen as a mismatch.
+    assert verify_fill_readback("My answer.", "<p>My answer.</p>") is True
+
+
+def test_readback_empty_actual_is_false():
+    # FR-012: an empty read-back (nothing landed in the field, or it was cleared) must
+    # fail verification against a non-empty intended response.
+    assert verify_fill_readback("My answer.", "") is False
+
+
+def test_readback_intended_angle_brackets_not_a_false_match():
+    # FR-012 fail-safe: the operator's response may legitimately contain angle brackets
+    # (code, generics, math like a<b). A read-back with DIFFERENT bracketed content must
+    # NOT verify True — stripping markup from the *intended* side would fail OPEN on this
+    # safety gate, letting a garbled paste pass. This guards that regression.
+    assert verify_fill_readback("Use Vec<String>", "Use Vec<HashMap>") is False
+    assert verify_fill_readback("x <1> y", "x <2> y") is False
+
+
+# --- T010: due-date parsing & soonest-due selection (FR-004) ---
+
+
+def test_parse_discussions_reads_rows_and_due_dates(discussions_fixture_html):
+    # FR-004: each list row yields a title, its url, and a parsed due date (or None for the
+    # ungraded rows that carry no "Due date:" cell). Catches a row selector that misses
+    # rows or one that cannot reach the due-date cell nested inside the row.
+    items = parse_discussions(discussions_fixture_html)
+    assert len(items) == 7
+    dated = [i for i in items if i.due_date is not None]
+    assert len(dated) == 5  # 2 of the 7 (Course Questions, Meet Your Faculty) are ungraded
+    assert min(i.due_date for i in dated) == dt.date(2026, 6, 2)
+    assert all(i.url and i.url.startswith("http") for i in items)
+
+
+def test_select_soonest_due_from_fixture(discussions_fixture_html):
+    # FR-004: pick the nearest FUTURE due date.
+    items = parse_discussions(discussions_fixture_html)
+    chosen = select_soonest_due(items, today=dt.date(2026, 6, 1))
+    assert chosen.due_date == min(
+        i.due_date for i in items if i.due_date and i.due_date >= dt.date(2026, 6, 1)
+    )
+
+
+def test_no_upcoming_due_returns_none():
+    # FR-014 edge: all past → no target.
+    items = [type("D", (), {"title": "old", "due_date": dt.date(2020, 1, 1), "url": "u"})()]
+    assert select_soonest_due(items, today=dt.date(2026, 6, 1)) is None
+
+
+def test_unparseable_due_skipped():
+    items = [
+        type("D", (), {"title": "bad", "due_date": None, "url": "a"})(),
+        type("D", (), {"title": "good", "due_date": dt.date(2026, 6, 8), "url": "b"})(),
+    ]
+    assert select_soonest_due(items, today=dt.date(2026, 6, 1)).title == "good"
+
+
+def test_select_soonest_due_tie_breaks_on_list_order():
+    # edge: a tie on due date resolves to the earliest in list order (deterministic).
+    same = dt.date(2026, 6, 8)
+    items = [
+        type("D", (), {"title": "first", "due_date": same, "url": "a"})(),
+        type("D", (), {"title": "second", "due_date": same, "url": "b"})(),
+    ]
+    assert select_soonest_due(items, today=dt.date(2026, 6, 1)).title == "first"
+
+
+def test_select_soonest_due_empty_list_returns_none():
+    # edge: nothing parsed at all → no target (caller raises NoUpcomingDiscussion).
+    assert select_soonest_due([], today=dt.date(2026, 6, 1)) is None
+
+
+def test_parse_discussions_robust_to_bad_and_linkless_rows():
+    # FR-004/FR-014: a malformed or unparseable "Due date:" must yield due_date=None (not a
+    # crash, not a bogus date), and a row with no discussion link must be skipped (not a
+    # blank-title/empty-url phantom). Catches: strptime crashing the whole parse on one bad
+    # cell, and link-less rows leaking into the result. Synthetic markup mirrors the live
+    # Ultra class shape (makeStyles<rule>-0-2-NNN) the selectors key off.
+    html = """
+    <div class="makeStylescontentListItem-0-2-1">
+      <a href="https://vle.phoenix.edu/engagement/discussion/_1_1"
+         aria-label="Discussion, Empty Due">open</a>
+      <div class="makeStylesgradeDetail-0-2-1">Due date:  (PST)</div>
+    </div>
+    <div class="makeStylescontentListItem-0-2-2">
+      <a href="https://vle.phoenix.edu/engagement/discussion/_2_1"
+         aria-label="Discussion, Bogus Due">open</a>
+      <div class="makeStylesgradeDetail-0-2-2">Due date: someday next week</div>
+    </div>
+    <div class="makeStylescontentListItem-0-2-3">
+      <div class="makeStylesgradeDetail-0-2-3">Due date: 6/9/26, 1:59 AM (CDT)</div>
+    </div>
+    """
+    items = parse_discussions(html)
+    assert [i.title for i in items] == ["Empty Due", "Bogus Due"]  # linkless row dropped
+    assert all(i.due_date is None for i in items)  # empty + unparseable both → None
+
+
+# --- T011: prompt extraction (FR-006) ---
+
+
+def test_extract_prompt_text_from_fixture(discussion_page_fixture_html):
+    # FR-006: the instructor prompt is returned as normalized plaintext from the FIRST
+    # prompt container (the #bb-editor-textbox id is reused by every read-only post, so a
+    # selector that grabbed the last/all matches would return the wrong text or a concat).
+    text = extract_prompt_text(discussion_page_fixture_html)
+    assert "Please take a moment and share a few facts about yourself" in text
+    assert "<" not in text  # markup stripped
+
+
+def test_extract_prompt_text_collapses_whitespace(discussion_page_fixture_html):
+    # FR-006: plaintext is normalized — no doubled spaces or stray newlines leak through.
+    text = extract_prompt_text(discussion_page_fixture_html)
+    assert "  " not in text and "\n" not in text
+
+
+def test_extract_prompt_text_missing_container_returns_empty():
+    # edge: a page with no prompt container yields "" (caller treats empty as a failure),
+    # rather than crashing on a None node.
+    assert extract_prompt_text("<html><body><p>no prompt here</p></body></html>") == ""
+
+
+# --- T006: login-page predicate (FR-003) ---
+
+
+def test_login_page_detected_by_marker(login_fixture_html, login_url):
+    # FR-003: recognise the login screen so we can pause for manual login.
+    assert is_login_page(login_url, login_fixture_html) is True
+
+
+def test_authenticated_page_not_login(discussions_fixture_html, discussions_url):
+    # FR-003: an authenticated portal page is NOT the login screen (no false pause).
+    assert is_login_page(discussions_url, discussions_fixture_html) is False
+
+
+def test_login_page_detected_by_url_when_marker_absent():
+    # FR-003: a login redirect can show a /login URL before its body (and the marker)
+    # renders; the URL signal alone still pauses for manual login.
+    assert is_login_page("https://www.phoenix.edu/login", "<html><body>…</body></html>") is True
diff --git a/tests/test_selector_confinement.py b/tests/test_selector_confinement.py
new file mode 100644
index 0000000..52acd27
--- /dev/null
+++ b/tests/test_selector_confinement.py
@@ -0,0 +1,22 @@
+"""FR-013 / SC-002: portal selectors must live in exactly one module — the adapter.
+
+This is a structural invariant test, not a behavioural one: it falsifiably guards that no
+module other than ``portal_adapter`` declares a ``SELECTORS`` table. Adding ``SELECTORS``
+to any other ``src/discuss`` module turns this red. Runs without the live portal.
+"""
+
+import pathlib
+
+_SRC = pathlib.Path(__file__).resolve().parent.parent / "src" / "discuss"
+
+
+def test_selectors_confined_to_adapter():
+    # FR-013/SC-002: a portal markup change must be a one-file fix, so the selector table
+    # may exist only in portal_adapter.py. Pure consumers import the selector *values* by
+    # their named constants; none re-declares the table.
+    offenders = [
+        p.name
+        for p in _SRC.glob("*.py")
+        if p.name != "portal_adapter.py" and "SELECTORS" in p.read_text(encoding="utf-8")
+    ]
+    assert offenders == []
diff --git a/tests/test_validate.py b/tests/test_validate.py
new file mode 100644
index 0000000..8f50d5c
--- /dev/null
+++ b/tests/test_validate.py
@@ -0,0 +1,237 @@
+"""T025 — `discuss validate` guided live-check flow logic (FR-017, FR-018).
+
+The guided walk drives each live step itself and gates every visual checkpoint on a
+single-keypress confirm; on a selector miss it self-snapshots the live DOM (FR-018) and
+stops, naming `portal_adapter.py` as the one-file fix — the operator never hand-captures
+markup. The *flow logic* (single-keypress prompts; decline aborts; miss → snapshot+stop) is
+unit-tested here with a fake page + fake adapter + a tmp fixtures dir; the irreducibly-live
+run is T026.
+"""
+
+import datetime as dt
+
+import pytest
+
+from discuss import cli
+from discuss.config import Config
+from discuss.errors import NotAuthenticated, SelectorMiss
+from discuss.portal_parse import Discussion
+
+
+# --- fakes: a page whose content() is capturable, an adapter that can miss at a named step -
+
+
+class _FakePage:
+    url = "https://vle.phoenix.edu/ultra/courses/_577963_1/engagement"
+
+    def content(self):
+        return "<html><body>captured live markup</body></html>"
+
+
+def fake_page_factory(miss_at=None):
+    # models the live page; the miss is driven by the adapter (miss_at is accepted so the
+    # call site reads naturally, but the page itself is always a capturable snapshot).
+    return _FakePage()
+
+
+class FakeAdapter:
+    """Stand-in for the live portal_adapter, configurable to raise SelectorMiss at a step."""
+
+    def __init__(self, miss=None):
+        self.miss = miss
+        self.filled = False
+        self.fill_text = None
+
+    def go_to_discussions(self, page, class_id):
+        if self.miss == "navigate":
+            raise SelectorMiss("discussions list did not render")
+
+    def list_discussions(self, page):
+        if self.miss == "list":
+            raise SelectorMiss("rows did not resolve")
+        return [Discussion(title="Wk 1 Discussion: Critical Thinking",
+                           due_date=dt.date(2999, 1, 1), url="u")]
+
+    def open_discussion(self, page, discussion):
+        if self.miss == "open":
+            raise SelectorMiss("prompt container not found")
+
+    def extract_prompt(self, page):
+        if self.miss == "extract":
+            raise SelectorMiss("prompt text was empty")
+        return "Discuss the assigned prompt in your own words."
+
+    def fill_reply(self, page, text):
+        if self.miss == "fill":
+            raise SelectorMiss("reply field not found")
+        self.filled = True
+        self.fill_text = text
+
+
+def _confirm_first_n(n):
+    """A confirm that says yes to the first n checkpoints, then no — to drive declines."""
+    calls = {"i": 0}
+
+    def confirm(prompt):
+        calls["i"] += 1
+        return calls["i"] <= n
+
+    return confirm
+
+
+# --- the two task-specified tests ------------------------------------------------------
+
+
+def test_guided_validation_uses_single_keypress_confirms(monkeypatch, tmp_path):
+    # FR-017: every checkpoint is a single-keypress confirm; declining stops the walk.
+    prompts = []
+
+    def fake_confirm(p):
+        prompts.append(p)
+        return True
+
+    cli.validate(fake_page_factory(), adapter=FakeAdapter(), confirm=fake_confirm,
+                 fixtures_dir=tmp_path)
+    assert prompts, "validate must ask the operator to confirm at least one checkpoint"
+    assert all("[y]" in p.lower() for p in prompts)             # single-keypress shape
+
+
+def test_validate_snapshots_dom_on_selector_miss(tmp_path):
+    # FR-018: a selector miss self-snapshots the live DOM; operator never hand-captures.
+    cli.validate(fake_page_factory(miss_at="extract"), adapter=FakeAdapter(miss="extract"),
+                 confirm=lambda p: True, fixtures_dir=tmp_path)
+    assert list(tmp_path.glob("*_live.html")), "a selector miss must snapshot the DOM"
+
+
+# --- added: full branch coverage of the flow logic -------------------------------------
+
+
+def test_validate_happy_path_walks_and_fills_without_submitting(tmp_path):
+    # the clean walk: every checkpoint confirmed → rc 0, the field was filled (never submitted),
+    # and the sample text the operator eyeballs was the one handed to fill_reply.
+    adapter = FakeAdapter()
+    rc = cli.validate(fake_page_factory(), adapter=adapter, confirm=lambda p: True,
+                      fixtures_dir=tmp_path, today=dt.date(2026, 6, 1))
+    assert rc == 0
+    assert adapter.filled is True
+    assert adapter.fill_text  # a non-empty sample reply was injected for the operator to see
+
+
+def test_validate_stops_when_nothing_upcoming(tmp_path):
+    # no upcoming discussion → stop before any confirm; never reach a fill.
+    adapter = FakeAdapter()
+    asked = []
+    rc = cli.validate(fake_page_factory(), adapter=adapter,
+                      confirm=lambda p: asked.append(p) or True, fixtures_dir=tmp_path,
+                      today=dt.date(3000, 1, 1))  # the only discussion (2999) is now past
+    assert rc != 0
+    assert adapter.filled is False
+    assert asked == []  # stopped before the first checkpoint
+
+
+def test_validate_stops_when_selection_declined(tmp_path):
+    # decline the FIRST checkpoint (selection) → abort before extract/fill.
+    adapter = FakeAdapter()
+    rc = cli.validate(fake_page_factory(), adapter=adapter, confirm=_confirm_first_n(0),
+                      fixtures_dir=tmp_path)
+    assert rc != 0
+    assert adapter.filled is False
+
+
+def test_validate_stops_when_prompt_declined(tmp_path):
+    # confirm selection, then decline the prompt checkpoint → never fill.
+    adapter = FakeAdapter()
+    rc = cli.validate(fake_page_factory(), adapter=adapter, confirm=_confirm_first_n(1),
+                      fixtures_dir=tmp_path)
+    assert rc != 0
+    assert adapter.filled is False
+
+
+def test_validate_stops_when_fill_declined(tmp_path):
+    # confirm selection + prompt, fill happens, then decline the fill checkpoint → rc nonzero.
+    adapter = FakeAdapter()
+    rc = cli.validate(fake_page_factory(), adapter=adapter, confirm=_confirm_first_n(2),
+                      fixtures_dir=tmp_path)
+    assert rc != 0
+    assert adapter.filled is True  # the fill ran; the operator judged it wrong
+
+
+def test_validate_snapshots_named_step_on_navigate_miss(tmp_path):
+    # a miss at the first step snapshots a file named for THAT step, and reports rc 3.
+    rc = cli.validate(fake_page_factory(), adapter=FakeAdapter(miss="navigate"),
+                      confirm=lambda p: True, fixtures_dir=tmp_path)
+    assert rc == 3
+    assert (tmp_path / "navigate_live.html").exists()
+
+
+def test_validate_self_snapshots_even_when_fixtures_dir_absent(tmp_path):
+    # FR-018 robustness: the tool must capture the live markup ITSELF even from a CWD whose
+    # fixtures dir does not exist yet — a missing dir must never turn the snapshot into a
+    # traceback (it would defeat the "tool self-captures, operator never hand-captures" point).
+    target = tmp_path / "not_created_yet"
+    rc = cli.validate(fake_page_factory(), adapter=FakeAdapter(miss="navigate"),
+                      confirm=lambda p: True, fixtures_dir=target)
+    assert rc == 3
+    assert (target / "navigate_live.html").exists()
+
+
+# --- the `discuss validate` dispatch + the live wrapper --------------------------------
+
+
+def test_main_dispatches_validate_subcommand(monkeypatch):
+    # `discuss validate` routes to the validate wrapper (not the draft pipeline).
+    seen = {}
+    monkeypatch.setattr(cli, "_run_validate", lambda config: seen.setdefault("rc", 0) or 0)
+    rc = cli.main(["validate"])
+    assert rc == 0
+    assert "rc" in seen  # the validate wrapper, not run(), handled it
+
+
+def test_run_validate_requires_a_target_class(capsys):
+    # no class configured → fail loud with guidance, never open a browser.
+    rc = cli._run_validate(Config.load({}))
+    assert rc == 2
+    assert "DISCUSS_TARGET_CLASSES" in capsys.readouterr().out
+
+
+def test_run_validate_opens_context_and_walks(monkeypatch):
+    # the live wrapper opens the PERSISTENT context, then runs the guided walk against the real
+    # adapter. Post-Esc#2 there is NO pre-navigation login pause here — the manual-login pause
+    # now lives INSIDE the walk, after the first navigation (so it can see the SSO redirect).
+    # All live calls stubbed so no browser is touched.
+    calls = {}
+
+    def fake_open(profile_dir):
+        calls["profile"] = profile_dir
